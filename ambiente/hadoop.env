# ============================================================================
#  Configuracao do HDFS (lida pelas imagens bde2020).
#  Convencao: "_" vira ".", "__" vira "_" e "___" vira "-" no nome da chave.
# ============================================================================

# Endereco "oficial" do sistema de arquivos. Tudo que comecar com
# hdfs://namenode:9000/... cai aqui.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec

# Habilita acesso via WebHDFS (usado pela interface web).
HDFS_CONF_dfs_webhdfs_enabled=true

# Desliga checagem de permissoes (evita dor de cabeca quando o Spark grava).
HDFS_CONF_dfs_permissions_enabled=false

# So temos 1 DataNode, entao cada bloco tem apenas 1 copia (replicacao = 1).
HDFS_CONF_dfs_replication=1

# Faz cliente e servidor se enxergarem pelo HOSTNAME (namenode/datanode),
# que e o que funciona dentro da rede do Docker.
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
HDFS_CONF_dfs_client_use_datanode_hostname=true
HDFS_CONF_dfs_datanode_use_datanode_hostname=true
